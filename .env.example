# FitForge IC Stack — environment template
# Copy this file to .env before running setup:
#   cp .env.example .env

# Local SQLite database. No external DB needed for the cohort.
DATABASE_URL="file:./dev.db"

# --- Optional, only if your slice needs AI ---
# Most slices do NOT need this. Add it only if your plan uses an LLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
